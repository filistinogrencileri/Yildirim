# Copy to .env next to docker-compose.yml on the VPS. Do not commit the real .env.

# Domain pointed (A record) at this VPS's IP before starting the stack —
# Caddy needs it resolvable to issue the HTTPS certificate.
DOMAIN=example.com

# Postgres password (pick a strong random value).
POSTGRES_PASSWORD=change-me

# JWT signing secrets — generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Used once, manually, to seed the first admin account (see deploy notes) —
# not read by docker-compose itself.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me
